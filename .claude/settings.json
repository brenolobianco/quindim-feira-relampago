{
  "permissions": {
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git tag *)",
      "PowerShell(git rebase *)",
      "PowerShell(git reset --hard *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff.js\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
